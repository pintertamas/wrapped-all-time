# Public build-time defaults. Committed on purpose: every value here is public and ends up in the
# shipped HTML/JS. NEVER put a secret in this file or in any VITE_* variable.
# CI overrides these from GitHub Environment variables (github-pages = staging, production = live).
# An empty CI variable means "use the default below" (see vite.config.ts).

# Pages base path. CI sets /<repo>/ for GitHub Pages staging; / for local and production.
VITE_BASE_PATH=/
# The one product name string. Used in TS (src/config.ts) and HTML (%VITE_PRODUCT_NAME%).
VITE_PRODUCT_NAME=Listening Vault
# Canonical site URL (sitemap, watermark host). Staging default; production sets its pages.dev URL.
VITE_SITE_URL=https://pintertamas.github.io/wrapped-all-time/
# Canonical origin for the production site. Empty = VITE_SITE_URL. Staging points it at production.
VITE_CANONICAL_URL=
# index | noindex (staging: noindex)
VITE_ROBOTS=index
# Empty, or a label such as TEST SITE (staging)
VITE_ENV_LABEL=
# Hosted checkout link. Empty shows "coming soon".
VITE_CHECKOUT_URL=
# none | lemonsqueezy | gumroad
VITE_UNLOCK_PROVIDER=none
# Product/store IDs a license key must belong to (store ID only for Lemon Squeezy)
VITE_UNLOCK_PRODUCT_ID=
VITE_UNLOCK_STORE_ID=
# Public support contact (mailto or form). Empty hides the lost-code link.
VITE_SUPPORT_URL=
# none | goatcounter, and the GoatCounter site code
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_SITE=
# S2 Spotify login (flagged off). A PKCE client ID is public.
VITE_FEATURE_LOGIN=false
VITE_SPOTIFY_CLIENT_ID=
